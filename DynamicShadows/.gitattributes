# Memoria's .gitattributes sets "* text=auto" for the whole repo. There are binary
# formats here whose auto-detection is better not left to chance: a line-ending
# normalisation applied to an FBX or a bundle corrupts it silently, and it only
# shows up when opening it in Unity.
*.unity     binary
*.unity3d   binary
*.fbx       binary
*.exr       binary
*.asset     binary
*.mat       binary
*.blend     binary
*.png       binary
*.jpg       binary
*.tga       binary

# The PowerShell and Python scripts, and the .txt configuration the game reads,
# are text and do get normalised.
*.ps1       text
*.py        text
*.cs        text
*.shader    text
*.meta      text
